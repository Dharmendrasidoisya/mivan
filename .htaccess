# Never serve dotfiles, environment files, logs or archives from the project root.
<FilesMatch "(^\.|\.(env|log|ini|sql|sqlite|bak|old|swp)$|^(composer\.(json|lock)|package\.json|artisan|docker-compose\.yml|phpunit\.xml)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to application directories that must never be web served.
    RewriteRule ^(app|bootstrap|config|database|platform|resources|routes|tests)(/|$) - [F,L]
 
    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
 
    # Redirect everything to Laravel public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
 <IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"
</IfModule>